{
  "name": "Procesador de Documentos",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "process-document", "options": {} },
      "id": "dp1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "process-doc-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Procesa el siguiente documento y genera un análisis en español:\n\nDocumento:\n{{ $json.contenido }}\n\nMetadatos: {{ $json.metadata }}\n\nProporciona:\n1. Resumen ejecutivo (2-3 párrafos)\n2. Puntos clave (5-7 bullets)\n3. Entidades mencionadas\n4. Sentimiento general\n5. Temas principales\n6. Recomendaciones" },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "dp2",
      "name": "Procesar Documento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "analisis", "value": "={{ $json.response }}", "type": "string" },
            { "name": "tipo", "value": "={{ $json.metadata?.tipo || 'documento' }}", "type": "string" },
            { "name": "timestamp", "value": "={{ $now }}", "type": "string" }
          ]
        }
      },
      "id": "dp3",
      "name": "Formatear",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [650, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"exito\", \"analisis\": $json.analisis, \"tipo\": $json.tipo } }}" },
      "id": "dp4",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Procesar Documento", "type": "main", "index": 0 }]] },
    "Procesar Documento": { "main": [[{ "node": "Formatear", "type": "main", "index": 0 }]] },
    "Formatear": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "documentos", "nlp"],
  "triggerCount": 0
}
