{
  "name": "Automatización de Documentos",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "document-automation", "options": {} },
      "id": "da1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "doc-automation-webhook"
    },
    {
      "parameters": {
        "functionCode": "const docs = $input.all()[0].json.documentos || [$input.all()[0].json];\nreturn docs.map(d => ({ json: { contenido: d.contenido || d.texto, metadata: d.metadata || {}, id: d.id || Date.now().toString() } }));"
      },
      "id": "da2",
      "name": "Normalizar Documentos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Procesa el siguiente lote de documentos y genera un análisis consolidado en español:\n\nDocumentos a procesar:\n{{ $json.contenido }}\n\nGenera:\n1. Resumen consolidado\n2. Temas comunes entre documentos\n3. Diferencias clave\n4. Entidades principales\n5. Recomendaciones" },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "da3",
      "name": "Analizar Lote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"exito\", \"analisis\": $json.response } }}" },
      "id": "da4",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Normalizar Documentos", "type": "main", "index": 0 }]] },
    "Normalizar Documentos": { "main": [[{ "node": "Analizar Lote", "type": "main", "index": 0 }]] },
    "Analizar Lote": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "documentos", "automatizacion"],
  "triggerCount": 0
}
