{
  "name": "Revisor de Código",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "code-review", "options": {} },
      "id": "d0c3f5a8-1234-4567-89ab-cdef01234567",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "code-review-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Eres un revisor de código experto. Analiza el siguiente código y proporciona una revisión detallada en español:\n\nLenguaje: {{ $json.language }}\n\nCódigo:\n```\n{{ $json.code }}\n```\n\nRevisa:\n1. Calidad del código y buenas prácticas\n2. Posibles bugs o errores\n3. Optimizaciones sugeridas\n4. Seguridad\n5. Documentación necesaria\n6. Pruebas recomendadas\n\nResponde en español con formato estructurado." },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-5678-90ab-cdef-1234567890ab",
      "name": "Ollama Code Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "review-id", "name": "review", "value": "={{ $json.response }}", "type": "string" },
            { "id": "timestamp-id", "name": "timestamp", "value": "={{ $now }}", "type": "string" },
            { "id": "language-id", "name": "language", "value": "={{ $('Webhook').item.json.language }}", "type": "string" },
            { "id": "severity-id", "name": "severity", "value": "={{ $json.response.includes('crítico') ? 'alta' : $json.response.includes('importante') ? 'media' : 'baja' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-6789-01ab-cdef-234567890abc",
      "name": "Formatear Respuesta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"exito\", \"revision\": $json.review, \"severidad\": $json.severity, \"lenguaje\": $json.language, \"timestamp\": $json.timestamp } }}"
      },
      "id": "d4e5f6a7-8901-23ab-cdef-4567890abcde",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Ollama Code Review", "type": "main", "index": 0 }]] },
    "Ollama Code Review": { "main": [[{ "node": "Formatear Respuesta", "type": "main", "index": 0 }]] },
    "Formatear Respuesta": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["ia", "desarrollo", "code-review"],
  "triggerCount": 0
}
