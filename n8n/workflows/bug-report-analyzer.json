{
  "name": "Analizador de Bugs",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "bug-report", "options": {} },
      "id": "b1-1234-5678",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "bug-report-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Eres un analizador de bugs experto. Analiza el siguiente reporte en español:\n\nTítulo: {{ $json.titulo }}\nDescripción: {{ $json.descripcion }}\nStacktrace: {{ $json.stacktrace }}\n\nProporciona:\n1. Causa raíz probable\n2. Severidad (baja/media/alta/crítica)\n3. Solución sugerida\n4. Archivos afectados\n5. Pasos para reproducir\n6. Pruebas para verificar la solución\n\nResponde en español con formato estructurado." },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "b2-2345-6789",
      "name": "Analizar Bug",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "analisis", "value": "={{ $json.response }}", "type": "string" },
            { "name": "timestamp", "value": "={{ $now }}", "type": "string" }
          ]
        }
      },
      "id": "b3-3456-7890",
      "name": "Formatear",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [650, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"exito\", \"analisis\": $json.analisis, \"timestamp\": $json.timestamp } }}" },
      "id": "b4-4567-8901",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Analizar Bug", "type": "main", "index": 0 }]] },
    "Analizar Bug": { "main": [[{ "node": "Formatear", "type": "main", "index": 0 }]] },
    "Formatear": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "qa", "debugging"],
  "triggerCount": 0
}
