{
  "name": "Generador de Documentación API",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "generate-api-docs", "options": {} },
      "id": "d1-1234",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "api-docs-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Genera documentación de API en español para el siguiente endpoint:\n\nEndpoint: {{ $json.endpoint }}\nMétodo: {{ $json.metodo }}\nParámetros: {{ $json.params }}\nRespuesta: {{ $json.response }}\n\nIncluye:\n1. Descripción del endpoint\n2. Método HTTP\n3. Parámetros (query, body, headers)\n4. Ejemplo de request\n5. Ejemplo de response\n6. Códigos de error posibles\n7. Notas de uso\n\nFormato: Markdown y especificación OpenAPI." },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "d2-2345",
      "name": "Generar Docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"exito\", \"documentacion\": $json.response } }}" },
      "id": "d3-3456",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Generar Docs", "type": "main", "index": 0 }]] },
    "Generar Docs": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "documentacion", "api"],
  "triggerCount": 0
}
