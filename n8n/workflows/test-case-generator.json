{
  "name": "Generador de Pruebas",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "generate-tests", "options": {} },
      "id": "t1-1234",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "tests-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Eres un experto en testing. Genera casos de prueba para el siguiente código en español:\n\nLenguaje: {{ $json.lenguaje }}\nFramework de prueba: {{ $json.framework }}\n\nCódigo:\n```\n{{ $json.codigo }}\n```\n\nGenera:\n1. Pruebas unitarias para cada función\n2. Pruebas de integración\n3. Casos edge/borde\n4. Pruebas de error\n5. Mocking necesario\n6. Comentarios explicativos en español" },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "t2-2345",
      "name": "Generar Tests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "pruebas", "value": "={{ $json.response }}", "type": "string" },
            { "name": "lenguaje", "value": "={{ $('Webhook').item.json.lenguaje }}", "type": "string" },
            { "name": "timestamp", "value": "={{ $now }}", "type": "string" }
          ]
        }
      },
      "id": "t3-3456",
      "name": "Formatear",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [650, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"exito\", \"pruebas\": $json.pruebas, \"lenguaje\": $json.lenguaje } }}" },
      "id": "t4-4567",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Generar Tests", "type": "main", "index": 0 }]] },
    "Generar Tests": { "main": [[{ "node": "Formatear", "type": "main", "index": 0 }]] },
    "Formatear": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "testing", "qa"],
  "triggerCount": 0
}
