{
  "name": "Sistema de Consultas Inteligentes",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "query", "options": {} },
      "id": "q1-1234",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "query-webhook"
    },
    {
      "parameters": {
        "operation": "get",
        "url": "http://qdrant:6333/collections/documentos/points/search",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "api-key", "value": "={{$env.N8N_QDRANT_API_KEY}}" }] },
        "sendBody": true,
        "bodyParameters": { "vector": "={{$node.Webhook.json.pregunta}}", "limit": 5, "with_payload": true },
        "options": {}
      },
      "id": "q2-2345",
      "name": "Buscar Documentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "const docs = $input.all()[0].json.result || [];\nlet contexto = 'Documentos relevantes encontrados:\\n\\n';\ndocs.forEach((d, i) => {\n  contexto += `[${i+1}] ${d.payload?.titulo || 'Sin título'}: ${d.payload?.contenido?.substring(0, 500) || ''}\\n\\n`;\n});\ncontexto += `Pregunta del usuario: ${$input.all()[1].json.pregunta}`;\nreturn { contexto };\n"
      },
      "id": "q3-3456",
      "name": "Preparar Contexto",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gemma4:latest" },
            { "name": "prompt", "value": "=Eres un asistente experto. Responde la pregunta basándote en los documentos proporcionados. Responde en español.\n\nContexto:\n{{ $node['Preparar Contexto'].json.contexto }}\n\nResponde de manera concisa y cita las fuentes [1], [2], etc. Si la información no está en los documentos, indícalo claramente." },
            { "name": "stream", "value": false }
          ]
        },
        "options": {}
      },
      "id": "q4-4567",
      "name": "Generar Respuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": { "respuesta": "={{$node['Generar Respuesta'].json.response}}", "fuentes": "={{$node['Buscar Documentos'].json.result.length}}" }
      },
      "id": "q5-5678",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Buscar Documentos", "type": "main", "index": 0 }]] },
    "Buscar Documentos": { "main": [[{ "node": "Preparar Contexto", "type": "main", "index": 0 }]] },
    "Preparar Contexto": { "main": [[{ "node": "Generar Respuesta", "type": "main", "index": 0 }]] },
    "Generar Respuesta": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["ia", "rag", "busqueda", "qdrant"],
  "triggerCount": 0
}
